<resources>
    <style name="Theme.VibePlayer" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorAccent">@color/vibe_accent</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="VibePlayer.ControlButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginHorizontal">6dp</item>
        <item name="android:minWidth">112dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/status_text</item>
        <item name="android:background">@drawable/control_button_background</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="VibePlayer.PlaybackIconButton" parent="android:style/Widget.Material.ImageButton">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/player_playback_focus</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">7dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:stateListAnimator">@animator/player_button_elevation</item>
    </style>

    <style name="VibePlayer.PlayPauseButton" parent="android:style/Widget.Material.ImageButton">
        <item name="android:layout_width">90dp</item>
        <item name="android:layout_height">90dp</item>
        <item name="android:background">@drawable/player_playback_focus</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">18dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:stateListAnimator">@animator/player_button_elevation</item>
    </style>

    <style name="VibePlayer.BottomIconButton" parent="android:style/Widget.Material.ImageButton">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/player_icon_focus</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="VibePlayer.QualityBadge" parent="android:style/Widget.Material.TextView">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/player_icon_focus</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="VibePlayer.SeriesSelector" parent="android:style/Widget.Material.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">112dp</item>
        <item name="android:background">@drawable/series_selector_background</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/status_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
